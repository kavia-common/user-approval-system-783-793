# Copy to .env and adjust paths/secrets for your environment.

# Absolute path to SQLite DB file produced by main_database
DB_PATH=/absolute/path/to/user-approval-system-783-794/main_database/myapp.db

# Secret used for signing JWTs
JWT_SECRET=replace-with-strong-secret

# Backend port
PORT=3001

# Optional
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# CORS_ALLOW_ORIGINS=http://localhost:3000
